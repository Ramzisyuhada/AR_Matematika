MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1370584441}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f176629c5139abe46b14fe2f4407031f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  angket:
    Judul: 
    PertanyaanList:
    - Id: 1
      teksPertanyaan: 'Aku lebih mudah mengingat pelajaran dengan:'
      opsiA: a. Menulis catatan
      opsiB: b. Mengatakannya dengan keras atau mengulang kata- kata dan poin penting
        dalam kepalaku
      opsiC: c. Melakukan dan mempraktikkan aktivitas atau membayangkannya sedang
        dilakukan
      jawabanTerpilih: 
    - Id: 2
      teksPertanyaan: 'Jika menjelaskan kepada seseorang, aku cenderung:'
      opsiA: a. Jelaskan kepada mereka dengan beragam cara sampai mengerti
      opsiB: b. Mendorong mereka untuk mencoba secara langsung dan mendiskusikan
        tentang gagasanku saat mereka melakukan/mencobanya
      opsiC: c. Menggambar apa yang aku maksud
      jawabanTerpilih: 
    - Id: 3
      teksPertanyaan: 'Cara belajar terbaik yang paling aku sukai:'
      opsiA: a. Mencoba mempraktikannya sendiri
      opsiB: b. Melihat bagaimana sesuatu hal dilakukan
      opsiC: c. Mendengar penjelasan seseorang
      jawabanTerpilih: 
    - Id: 4
      teksPertanyaan: 'Aku jadi bosan belajar, jika:'
      opsiA: a. Hanya diam dan duduk terus menerus
      opsiB: b. Tanpa ada gambar, warna, atau video
      opsiC: c. Tanpa diskusi atau suara guru
      jawabanTerpilih: 
  Pertanyaan: {fileID: 1199279778}
  A: {fileID: 523872919}
  B: {fileID: 1316141049}
  C: {fileID: 873356809}
  Nomer: {fileID: 511324313}
  buttonA: {fileID: 1283014271}
  buttonB: {fileID: 1493246430}
  buttonC: {fileID: 1228100620}
