MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1370584441}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f176629c5139abe46b14fe2f4407031f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  angket:
    Judul: 
    PertanyaanList:
    - Id: 1
      teksPertanyaan: 'Aku lebih mudah mengingat pelajaran dengan:'
      OpsiPertanyaan:
      - Id: 1
        teksPertanyaan: 'a. Menulis catatan '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 2
        teksPertanyaan: b. Mengatakannya dengan keras atau mengulang kata- kata dan
          poin penting dalam kepalaku
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 3
        teksPertanyaan: c. Melakukan dan mempraktikkan aktivitas atau membayangkannya
          sedang dilakukan
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
    - Id: 2
      teksPertanyaan: 'Jika menjelaskan kepada seseorang, aku cenderung:'
      OpsiPertanyaan:
      - Id: 1
        teksPertanyaan: Jelaskan kepada mereka dengan beragam cara sampai mengerti
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 2
        teksPertanyaan: 'Mendorong mereka untuk mencoba secara langsung dan mendiskusikan
          tentang gagasanku saat mereka melakukan/mencobanya '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 3
        teksPertanyaan: Menggambar apa yang aku maksud
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
    - Id: 3
      teksPertanyaan: 'Cara belajar terbaik yang paling aku sukai:'
      OpsiPertanyaan:
      - Id: 1
        teksPertanyaan: 'Mencoba mempraktikannya sendiri '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 2
        teksPertanyaan: 'Melihat bagaimana sesuatu hal dilakukan '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 0
        teksPertanyaan: Mendengar penjelasan seseorang
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
    - Id: 4
      teksPertanyaan: 'Ketika ingin menggunakan peralatan baru, biasanya aku:'
      OpsiPertanyaan:
      - Id: 1
        teksPertanyaan: 'Membaca instruksinya terlebih dahulu '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 2
        teksPertanyaan: Mendengarkan penjelasan dari seseorang yang pernah menggunakannya
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 3
        teksPertanyaan: 'Berusaha mencoba sendiri '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
    - Id: 5
      teksPertanyaan: 'Hal yang mudah aku ingat adalah :'
      OpsiPertanyaan:
      - Id: 1
        teksPertanyaan: Nama
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 2
        teksPertanyaan: 'Hal yang sudah aku lakukan '
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
      - Id: 3
        teksPertanyaan: Wajah
        OpsiJawabanA: 1
        OpsiJawabanB: 2
        OpsiJawabanC: 3
        jawabanTerpilih: 
  Pertanyaan: {fileID: 1199279778}
  A: {fileID: 523872919}
